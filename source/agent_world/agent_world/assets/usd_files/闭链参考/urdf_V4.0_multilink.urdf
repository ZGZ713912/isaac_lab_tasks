<?xml version="1.0" encoding="utf-8"?>
<!-- V4.0 pure chassis MULTILINK URDF (FULL INFO): 15 links, 14 joints.
     - inertial: base/shank/wheel verbatim from SolidWorks URDF; C0-C4 from
       metrology (uniform-density diagnostic mass + rho*unit-density inertia
       at part COM; NOT CAD material truth).
     - collision: visual-grade mesh (swap in assets/urdf_v40/collisions
       convex hulls for physics).
     - Two closed loops per side are CUT: C0_A and shank_E.
     - Zero pose = 68 deg reference assembly.
     - ACTIVE: hip_crank / knee / wheel (3 control DOFs per leg); PASSIVE pins
       do not auto-follow in plain URDF viewers. -->
<robot name="urdf_V4.0_multilink">
